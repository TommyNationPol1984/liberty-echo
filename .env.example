# Environment Configuration — Liberty Echo
# Copy this file to .env and fill in your actual values

## Node Environment
NODE_ENV=development
PORT=5000

## Supabase Configuration (Backend)
# Service role key — NEVER expose to frontend
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

## Supabase Configuration (Frontend)
# Public anon key — safe to expose in browser
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

## Stripe Configuration
# Publishable key — safe to expose in frontend
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_key_here

# Secret key — NEVER expose to frontend
STRIPE_SECRET_KEY=sk_live_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Price IDs (use REAL price IDs in production)
STRIPE_PRO_MONTHLY_PRICE_ID=price_1Abc123XyZ
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=price_2Def456XyZ

## TTS Provider Configuration
# Which provider to use: google-cloud-tts, elevenlabs, azure, custom
TTS_PROVIDER=google-cloud-tts

# Google Cloud TTS
GOOGLE_CLOUD_PROJECT_ID=your-project-id
GOOGLE_CLOUD_TTS_KEY_FILE=path/to/service-account-key.json

# ElevenLabs (alternative)
ELEVENLABS_API_KEY=your-elevenlabs-key-here

## AWS S3 (Audio Storage)
AWS_REGION=us-east-1
AWS_S3_BUCKET=liberty-echo-audio
AWS_ACCESS_KEY_ID=your-key-here
AWS_SECRET_ACCESS_KEY=your-secret-here

## Logging & Monitoring
LOG_LEVEL=info
SENTRY_DSN=https://your-sentry-dsn-here@sentry.io/project-id

## CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,https://liberty-echo.app

## Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20

## Security
JWT_EXPIRY=3600
REFRESH_TOKEN_EXPIRY=604800

# Set to "production" to disable mock Stripe, enforce JWT, require webhook signatures
FORCE_PRODUCTION_GUARDS=false
